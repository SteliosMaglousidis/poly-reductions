fun append_tscom :: "tscom \<Rightarrow> tscom \<Rightarrow> tscom"  where 
   "append_tscom (IF b\<noteq>0 THEN c1 ELSE c2) c = (IF b\<noteq>0 THEN append_tscom c1 c ELSE append_tscom c2 c)" 
  |"append_tscom (c1 ;; c2) c = (c1 ;; append_tscom c2 c)" 
  |"append_tscom c' c = c' ;; c" 

lemma append_sound: "c' \<turnstile> (c1;;c2,s,stack) \<Rightarrow>\<^bsup>t \<^esup> (s',stack') \<Longrightarrow> c' \<turnstile> (append_tscom c1 c2,s,stack) \<Rightarrow>\<^bsup>t \<^esup> (s',stack')" 
  apply (induction c1 c2 arbitrary: c' s stack t s' stack' rule: append_tscom.induct)
  apply auto 
  by fastforce+

lemma append_complete: "c' \<turnstile> (append_tscom c1 c2,s,stack) \<Rightarrow>\<^bsup>t \<^esup> (s',stack') \<Longrightarrow> c' \<turnstile> (c1;;c2,s,stack) \<Rightarrow>\<^bsup>t \<^esup> (s',stack')" 
  apply (induction c1 c2 arbitrary: c' s stack t s' stack' rule: append_tscom.induct)
  apply auto 
  by fastforce+

corollary append_correct: "c' \<turnstile> (append_tscom c1 c2,s,stack) \<Rightarrow>\<^bsup>t \<^esup> (s',stack') \<equiv> c' \<turnstile> (c1;;c2,s,stack) \<Rightarrow>\<^bsup>t \<^esup> (s',stack')" 
  by (smt (verit) append_complete append_sound)

fun normalize_branching :: "tscom \<Rightarrow> tscom" ("NORM _ ") where 
   "NORM (IF b\<noteq>0 THEN c1 ELSE c2) = (IF b\<noteq>0 THEN NORM c1 ELSE NORM c2)" 
  |"NORM (c1 ;; c2) =  (append_tscom (NORM c1) (NORM c2))" 
  |"NORM c = c" 

lemma normalize_branching_sound: "c' \<turnstile> (c,s,stack) \<Rightarrow>\<^bsup>t \<^esup> (s',stack') \<Longrightarrow> c' \<turnstile> (NORM c,s,stack) \<Rightarrow>\<^bsup>t \<^esup> (s',stack')" 
  apply (induction c arbitrary: c' s stack t s' stack' rule: normalize_branching.induct)
         apply auto apply fastforce
   apply fastforce
  by (meson append_correct tSeq)

lemma normalize_branching_complete: "c' \<turnstile> (NORM c,s,stack) \<Rightarrow>\<^bsup>t \<^esup> (s',stack') \<Longrightarrow> c' \<turnstile> (c,s,stack) \<Rightarrow>\<^bsup>t \<^esup> (s',stack')" 
  apply (induction c arbitrary: c' s stack t s' stack' rule: normalize_branching.induct)
         apply auto apply fastforce
   apply fastforce 
  by (smt (verit, ccfv_threshold) append_complete tSeq tSeq_tE)

corollary normalize_branching_correct: "c' \<turnstile> (NORM c,s,stack) \<Rightarrow>\<^bsup>t\<^esup> (s',stack') \<equiv> c' \<turnstile> (c,s,stack) \<Rightarrow>\<^bsup>t\<^esup> (s',stack')" 
  by (smt (verit, ccfv_SIG) normalize_branching_complete normalize_branching_sound)

abbreviation "merge_branch \<equiv> (IF ''b''\<noteq>0 THEN (''r'' ::= A (N 0)) ELSE (''r'' ::= A (N 1))) ;; (IF ''b''\<noteq>0 THEN (''r'' ::= A (N 0)) ELSE (''r'' ::= A (N 1))) ;;  (''r'' ::= A (N 2))"

value "normalize_branching merge_branch"

lemma normalize_branching_split: "NORM c = c1;;c2 \<Longrightarrow> \<forall> b c3 c4. c1 \<noteq> (IF b\<noteq>0 THEN c3 ELSE c4)"
  apply (induction c arbitrary: c1 c2 rule: normalize_branching.induct)
         apply auto
  sorry


fun tail_count :: "tscom \<Rightarrow> nat" ("_ #Tail")where
   "(IF b\<noteq>0 THEN c1 ELSE c2) #Tail = c1 #Tail + c2 #Tail" 
  |"(c1 ;; c2) #Tail = c1 #Tail + c2 #Tail" 
  |"TAIL #Tail = 1" 
  |"_ #Tail = 0"

fun count_tails :: "tscom \<Rightarrow> vname \<Rightarrow> nat \<Rightarrow> tscom"  ("PCTAILS _ _ _") where 
   "PCTAILS (IF b\<noteq>0 THEN c1 ELSE c2) pc n = (IF b\<noteq>0 THEN PCTAILS c1 pc n ELSE PCTAILS c2 pc (c1 #Tail + n))" 
  |"PCTAILS (c1 ;; c2) pc n =  (PCTAILS c1 pc n) ;; (PCTAILS c2 pc (c1 #Tail + n))" 
  |"PCTAILS TAIL pc n  = ( pc ::= A (N n) ;;
                          PUSH pc ;;
                          pc ::= A (N 1) ;; 
                          TAIL ;;
                          POP pc)" 
  |"PCTAILS c pc n = c"


fun term_point_count :: "tscom_tagged \<Rightarrow> nat" ("_ #Term")where
   "(#IF b\<noteq>0 THEN c1 ELSE c2) #Term = c1 #Term + c2 #Term" 
  |"(c1 #;; c2) #Term = c2 #Term" 
  |"_ #Term= 1" 

fun ret_point_list :: "tscom_tagged \<Rightarrow> nat list" ("{ _ Ret\<rightharpoonup>i}")where
   "{#IF b\<noteq>0 THEN c1 ELSE c2 Ret\<rightharpoonup>i} = {c1 Ret\<rightharpoonup>i} @ {c2 Ret\<rightharpoonup>i}" 
  |"{c1 #;; c2 Ret\<rightharpoonup>i} = {c1 Ret\<rightharpoonup>i} @ {c2 Ret\<rightharpoonup>i}" 
  |"{#Some i\<rightharpoonup> SKIP Ret\<rightharpoonup>i} = [i]" 
  |"{#(Some i)\<rightharpoonup> _ ::= _ Ret\<rightharpoonup>i} = [i]" 
  |"{#Some i\<rightharpoonup> CALL _ RETURN _ Ret\<rightharpoonup>i} = [i]" 
  |"{#Some i\<rightharpoonup> TAIL Ret\<rightharpoonup>i} = [i]" 
  |"{#Some i\<rightharpoonup> PUSH _ Ret\<rightharpoonup>i} = [i]" 
  |"{#Some i\<rightharpoonup> POP _ Ret\<rightharpoonup>i} = [i]" 
  |"{_ Ret\<rightharpoonup>i} = []" 

(*1. Cut a command upto the first tail statement(s) syntactically and annotate its return point(s)*)

fun upto_rec_and_rest_syn :: "tscom_tagged \<Rightarrow> nat \<Rightarrow> bool \<Rightarrow> tscom_tagged * tscom_tagged list" ("UPTO\<lbrakk> _ \<rbrakk> _ \<Zsurj> _" 55) where
   "UPTO\<lbrakk>#IF b\<noteq>0 THEN c1 ELSE c2\<rbrakk> n \<Zsurj> B =
    (let (ut1,r1) = UPTO\<lbrakk>c1\<rbrakk> n \<Zsurj> B in 
      (let (ut2,r2) = UPTO\<lbrakk>c2\<rbrakk> (length r1 + n) \<Zsurj> B in 
        (#IF b\<noteq>0 THEN ut1 ELSE ut2,r1@r2)))"
  |"UPTO\<lbrakk>c1 #;; c2\<rbrakk> n \<Zsurj> B = 
     (if stails_tagged c1 then 
       (let (ut1,r1) = UPTO\<lbrakk>c1\<rbrakk> n \<Zsurj> True in (ut1, if r1 = [] then [c2] else map (\<lambda>x. x #;; c2) r1)) 
      else 
       (let (ut2,r2) = UPTO\<lbrakk>c2\<rbrakk> n \<Zsurj> B in
         (c1 #;; ut2, r2)))" 
  |"UPTO\<lbrakk>#i\<rightharpoonup> SKIP\<rbrakk> n \<Zsurj> B = (#(if B then Some n else None)\<rightharpoonup> SKIP,[])" 
  |"UPTO\<lbrakk>#i\<rightharpoonup> x ::= a\<rbrakk> n \<Zsurj> B = (#(if B then Some n else None)\<rightharpoonup> x ::= a,[])" 
  |"UPTO\<lbrakk>#i\<rightharpoonup> CALL c RETURN r \<rbrakk> n \<Zsurj> B = (#(if B then Some n else None)\<rightharpoonup> CALL c RETURN r ,[])" 
  |"UPTO\<lbrakk>#i\<rightharpoonup> TAIL\<rbrakk> n \<Zsurj> B = (#(if B then Some n else None) \<rightharpoonup> TAIL,[])" 
  |"UPTO\<lbrakk>#i\<rightharpoonup> PUSH v\<rbrakk> n \<Zsurj> B = (#(if B then Some n else None) \<rightharpoonup> PUSH v,[])" 
  |"UPTO\<lbrakk>#i\<rightharpoonup> POP v\<rbrakk> n \<Zsurj> B = (#(if B then Some n else None) \<rightharpoonup> POP v,[])" 


fun upto_rec_and_rest_syn_norm :: "tscom \<Rightarrow> vname \<Rightarrow> nat \<Rightarrow> tscom * tscom list" ("UPTON\<lbrakk> _ \<rbrakk> _ _ " 55) where
   "UPTON\<lbrakk>IF b\<noteq>0 THEN c1 ELSE c2\<rbrakk> pc n =
    (let (ut1,r1) = UPTON\<lbrakk>c1\<rbrakk> pc n in 
      (let (ut2,r2) = UPTON\<lbrakk>c2\<rbrakk> pc (n + length r1) in 
        (IF b\<noteq>0 THEN pc ::= A (N n) ;; ut1 ELSE pc ::= A (N (n + length r1)) ;; ut2,r1@r2)))"
  |"UPTON\<lbrakk>c1 ;; c2\<rbrakk> pc n = 
     (if stails c1 then 
       (let (ut1,r1) = UPTON\<lbrakk>c1\<rbrakk> pc (Suc n) in (pc ::= A (N (Suc n)) ;; ut1, if r1 = [] then [c2] else map (\<lambda>x. x ;; c2) r1)) 
      else 
       (let (ut2,r2) = UPTON\<lbrakk>c2\<rbrakk> pc n  in
         (c1 ;; ut2, r2)))" 
  |"UPTON\<lbrakk>c\<rbrakk> pc n = (c,[])" 


declare upto_rec_and_rest_syn.elims[elim]

lemmas upto_rec_and_rest_syn.elims

lemma rest_size : "UPTO\<lbrakk>c\<rbrakk> n \<Zsurj> b = (sb,rest) \<Longrightarrow> rc \<in> set rest \<Longrightarrow> size rc < size c"
proof (induction c n b arbitrary: sb rest  rc rule: upto_rec_and_rest_syn.induct)
  case (1 b c1 c2 n B)
  obtain sb1 rest1 sb2 rest2 
    where "UPTO\<lbrakk> c1 \<rbrakk> n \<Zsurj> B = (sb1, rest1)" "UPTO\<lbrakk> c2 \<rbrakk> (length rest1) + n \<Zsurj> B = (sb2, rest2)"
    by fastforce
  have "rest = rest1@rest2" using \<open>UPTO\<lbrakk> c1 \<rbrakk> n \<Zsurj> B = (sb1, rest1)\<close> \<open>UPTO\<lbrakk> c2 \<rbrakk> (length rest1) + n \<Zsurj> B = (sb2, rest2)\<close>
      \<open>UPTO\<lbrakk> #IF b\<noteq>0 THEN c1 ELSE c2 \<rbrakk> n \<Zsurj> B = (sb, rest)\<close> by simp
  hence \<open>rc \<in> set rest1 \<or> rc \<in> set rest2\<close> 
    using "1.prems"(2) by force
  then show ?case apply (cases "rc \<in> set rest1")
    apply auto 
    using "1.IH"(1) \<open>UPTO\<lbrakk> c1 \<rbrakk> n \<Zsurj> B = (sb1, rest1)\<close> apply force
    by (simp add: "1.IH"(2) \<open>UPTO\<lbrakk> c1 \<rbrakk> n \<Zsurj> B = (sb1, rest1)\<close> \<open>UPTO\<lbrakk> c2 \<rbrakk> (length rest1) + n \<Zsurj> B = (sb2, rest2)\<close> less_Suc_eq
        trans_less_add2)
next
  case (2 c1 c2 n B) 
  then show ?case proof(cases \<open>stails_tagged c1\<close>)
    case True
    obtain sb1 rest1 
    where "UPTO\<lbrakk> c1 \<rbrakk> n \<Zsurj> True = (sb1, rest1)" 
    by fastforce
    then show ?thesis proof(cases \<open>rest1 = []\<close>)
      case True
      have \<open>UPTO\<lbrakk> c1 #;; c2 \<rbrakk> n \<Zsurj> B = (sb1, [c2])\<close>  
        using \<open>UPTO\<lbrakk> c1 \<rbrakk> n \<Zsurj> True = (sb1, rest1)\<close> \<open>stails_tagged c1\<close> \<open>rest1 = []\<close> 
        by simp
      hence \<open>sb = sb1\<close> \<open>rest = [c2]\<close>  
        using "2.prems"(1) apply fastforce
        using "2.prems"(1) \<open>UPTO\<lbrakk> c1 #;; c2 \<rbrakk> n \<Zsurj> B = (sb1, [c2])\<close> by fastforce
        hence \<open>rc = c2\<close> 
          using "2.prems"(2) by fastforce
      then show ?thesis 
        by auto
    next
      case False
      have \<open>UPTO\<lbrakk> c1 #;; c2 \<rbrakk> n \<Zsurj> B = (sb1, map (\<lambda>x. x #;; c2) rest1)\<close>
        using \<open>UPTO\<lbrakk> c1 \<rbrakk> n \<Zsurj> True = (sb1, rest1)\<close> \<open>stails_tagged c1\<close> \<open>rest1 \<noteq> []\<close>
        by simp
      hence \<open>sb = sb1\<close> \<open>rest = map (\<lambda>x. x #;; c2) rest1\<close>  
        using "2.prems"(1) apply fastforce
        using "2.prems"(1) \<open>UPTO\<lbrakk> c1 #;; c2 \<rbrakk> n \<Zsurj> B = (sb1, map (\<lambda>x. x #;; c2) rest1)\<close>
        by force
      hence \<open>rc \<in> set (map (\<lambda>x. x #;; c2) rest1)\<close>
        using "2.prems"(2) by fastforce
      have \<open>\<forall>x. x \<in> set rest1 \<longrightarrow> size x \<le> size c1\<close>
        by (simp add: "2.IH"(1) True \<open>UPTO\<lbrakk> c1 \<rbrakk> n \<Zsurj> True = (sb1, rest1)\<close> order_le_less)
      hence \<open>\<forall>x. x \<in> set (map (\<lambda>x. x #;; c2) rest1) \<longrightarrow> size x \<le> size (c1 #;; c2)\<close>
        by auto
      then show ?thesis using \<open>rc \<in> set (map (\<lambda>x. x #;; c2) rest1)\<close> \<open>\<forall>x. x \<in> set (map (\<lambda>x. x #;; c2) rest1) \<longrightarrow> size x \<le> size (c1 #;; c2)\<close>
        using "2.IH"(1) True \<open>UPTO\<lbrakk> c1 \<rbrakk> n \<Zsurj> True = (sb1, rest1)\<close> by force
    qed
  next
    case False
    obtain sb2 rest2 
      where "UPTO\<lbrakk> c2 \<rbrakk> n \<Zsurj> B = (sb2, rest2)"
    by fastforce
    have \<open>UPTO\<lbrakk> c1 #;; c2 \<rbrakk> n \<Zsurj> B = (c1  #;; sb2, rest2)\<close>
      using False \<open>UPTO\<lbrakk> c2 \<rbrakk> n \<Zsurj> B = (sb2, rest2)\<close> by auto
    hence \<open>rest = rest2\<close>
      using "2.prems"(1) by auto
    hence \<open>rc \<in> set rest2\<close> using \<open>rc \<in> set rest\<close> by simp
    then show ?thesis 
      using "2.IH"(2) False \<open>UPTO\<lbrakk> c2 \<rbrakk> n \<Zsurj> B = (sb2, rest2)\<close>
      by fastforce
  qed
qed auto

(* 2. Recursively cut the return points until there are no return points left and accumulate the subprograms in a list *)
function upto_rec_and_rest_syn_bfs :: "tscom_tagged \<Rightarrow>tscom_tagged list" ("UPTO\<lbrace> _ \<rbrace>" 55)where
 "upto_rec_and_rest_syn_bfs c  = (let (csb,rest) = UPTO\<lbrakk> c \<rbrakk> 0 \<Zsurj> False in 
      (case rest of [] \<Rightarrow> [csb] 
                   | sb#sbs \<Rightarrow> csb #  concat (map  upto_rec_and_rest_syn_bfs (sb#sbs))))"
  by auto

termination upto_rec_and_rest_syn_bfs using rest_size 
  by (metis "termination" in_measure wf_measure)

(* 2. Assign a unique return point index its corresponding termination point*)

fun ret_point_count :: "tscom_tagged \<Rightarrow> nat" ("_ #Ret")where
   "(#IF b\<noteq>0 THEN c1 ELSE c2) #Ret = c1 #Ret + c2 #Ret" 
  |"(c1 #;; c2) #Ret = c2 #Ret" 
  |"#Some i\<rightharpoonup> SKIP #Ret = 1" 
  |"(#(Some i)\<rightharpoonup> x ::= a) #Ret = 1" 
  |"#Some i\<rightharpoonup> CALL c RETURN r #Ret = 1"
  |"#Some i\<rightharpoonup> TAIL #Ret = 1"
  |"#Some i\<rightharpoonup> PUSH v #Ret = 1"
  |"#Some i\<rightharpoonup> POP v #Ret = 1"
  |"_ #Ret = 0"

fun enum_ret_points_n :: "tscom_tagged \<Rightarrow> nat \<Rightarrow> tscom_tagged" ("_ \<diamondop>Ret _") where
   "(ct1 #;; ct2) \<diamondop>Ret i = ct1 #;; (ct2 \<diamondop>Ret i)" 
  |"(#IF b\<noteq>0 THEN ct1 ELSE ct2) \<diamondop>Ret i = (#IF b\<noteq>0 THEN (ct1 \<diamondop>Ret i) ELSE (ct2 \<diamondop>Ret (i + ct1 #Ret)))" 
  |"#Some j\<rightharpoonup> SKIP \<diamondop>Ret i = #Some i\<rightharpoonup> SKIP" 
  |"(#(Some j) \<rightharpoonup> x ::= a) \<diamondop>Ret i = #(Some i) \<rightharpoonup> x ::= a" 
  |"#Some j\<rightharpoonup> CALL c RETURN r \<diamondop>Ret i = #Some i\<rightharpoonup> CALL c RETURN r" 
  |"#Some j\<rightharpoonup> TAIL \<diamondop>Ret i = (#Some i\<rightharpoonup> TAIL)" 
  |"#Some j\<rightharpoonup> PUSH v \<diamondop>Ret i = (#Some i\<rightharpoonup> PUSH v)" 
  |"#Some j\<rightharpoonup> POP v \<diamondop>Ret i = (#Some i\<rightharpoonup> POP v)" 
  |"c \<diamondop>Ret i = c"

fun enum_ret_points_list_n :: "tscom_tagged list \<Rightarrow> nat \<Rightarrow> tscom_tagged list" ("_ \<diamondop>Ret* _") where
   "[] \<diamondop>Ret* n = []" 
  |"(c#cs) \<diamondop>Ret* n = (c \<diamondop>Ret n) # (cs \<diamondop>Ret* (n + c #Ret))" 


(* 3. Assign the return point to the program counter after a termination point and 
  push the return point index to the program counter stack in case of a recursive call *)


term "c1 ;; c2 ;; c3"

term "c1 ;; (c2 ;; c3)"

unbundle tscom_tagged_syntax and no com'_syntax and no rcom_tagged_syntax

definition "max_pc_value c \<equiv> (length (UPTO\<lbrace> c \<rbrace> \<diamondop>Ret* 0 ))"

fun add_stack_coms :: "tscom_tagged \<Rightarrow> vname \<Rightarrow> tscom_tagged" ("\<lblot>STACK _ PC _ \<rblot>")where 
 "add_stack_coms (ct1 #;; ct2) pc = (ct1 #;; add_stack_coms ct2 pc)" 
|"add_stack_coms (#IF b\<noteq>0 THEN ct1 ELSE ct2) pc =
  (#IF b\<noteq>0 THEN add_stack_coms ct1 pc ELSE add_stack_coms ct2 pc)" 
(*Recursive call with return point*)
|"add_stack_coms (#Some i\<rightharpoonup> TAIL) pc  = 
                            (#None \<rightharpoonup> pc ::= A (N i)) #;;
                            #None \<rightharpoonup> PUSH pc #;;
                            (#None \<rightharpoonup> pc ::= A (N 1)) #;; 
                            (#None \<rightharpoonup> TAIL)" 
(*Tail recursive call. Returns to a termination point*)
|"add_stack_coms (#None\<rightharpoonup> TAIL) pc = (#None\<rightharpoonup> TAIL)" 
(*Return points*)
|"add_stack_coms (#Some i\<rightharpoonup> SKIP) pc = 
                            (#None\<rightharpoonup> SKIP) #;;
                            (#None \<rightharpoonup> pc ::= A (N i)) #;;
                            (#None \<rightharpoonup> TAIL)"
|"add_stack_coms (#(Some i) \<rightharpoonup> x ::= a) pc = 
                            (#None\<rightharpoonup> x ::= a) #;;
                            (#None \<rightharpoonup> pc ::= A (N i)) #;;
                            (#None \<rightharpoonup> TAIL)"
|"add_stack_coms (#Some i\<rightharpoonup> CALL v RETURN r) pc = 
                            (#None\<rightharpoonup> CALL v RETURN r) #;;
                            (#None \<rightharpoonup> pc ::= A (N i)) #;;
                            (#None \<rightharpoonup> TAIL)"
(*Termination points*)
|"add_stack_coms c pc =   c #;;
                            #None \<rightharpoonup>POP pc #;; 
                            (#None \<rightharpoonup> TAIL)"

(*4. Initialize the program counter stack with the program exit value.
     Initialize program counter with program start value. *)


unbundle tscom_syntax and no com'_syntax and no rcom_syntax

definition "call_start c pc \<equiv> (IF pc = 0 THEN (
                                        (pc ::= A (N (max_pc_value c + 1))) ;;
                                        PUSH pc ;;
                                        (pc ::= A (N 1)) 
                                  )ELSE tsSKIP)"



(*5. Reset pc to 0 *)
definition "reset_pc pc \<equiv> pc ::= A (N 0)"

(* Give more structure and prove some modules that make sense*)
(* Include unique variables in the original program *)

definition "grec_to_trec c pc \<equiv> (
   let return_point_branches = (\<lambda>x. upto_rec_and_rest_syn_bfs #\<lbrakk> x \<rbrakk>) in
    let branches_to_tscom = (\<lambda>x. (map untag_tscom (map (\<lambda>x. add_stack_coms x pc) x))) in
  (call_start #\<lbrakk> c \<rbrakk> pc ) ;;
  (switch_basic pc (branches_to_tscom (return_point_branches (c))) ;;
   reset_pc pc))"

theorem grec_to_tirec_correct_gen:
(* Generalize pc.*)
  assumes "pc \<notin> set (vars c)"
  shows "c \<turnstile> (c,s,stack) \<Rightarrow>\<^bsup> t \<^esup> (s',stack') \<Longrightarrow> 
       \<exists>t . ((grec_to_trec c pc) \<turnstile> (grec_to_trec c pc,s,stack) \<Rightarrow>\<^bsup> t \<^esup> (s',stack))"
proof(induction c arbitrary: s stack t s' stack')
  oops
