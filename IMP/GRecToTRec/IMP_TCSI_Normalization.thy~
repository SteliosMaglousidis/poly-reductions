theory IMP_TCSI_Normalization
  imports IMP_TCS_Intermediate
begin

fun append_tscom :: "tscom \<Rightarrow> tscom \<Rightarrow> tscom"  where 
   "append_tscom (IF b\<noteq>0 THEN c1 ELSE c2) c = (IF b\<noteq>0 THEN append_tscom c1 c ELSE append_tscom c2 c)" 
  |"append_tscom (c1 ;; c2) c = (c1 ;; append_tscom c2 c)" 
  |"append_tscom c' c = c' ;; c" 

declare append_tscom.elims[elim]

lemma append_sound: "c' \<turnstile> (c1;;c2,s,stack) \<Rightarrow>\<^bsup>t \<^esup> (s',stack') \<Longrightarrow> c' \<turnstile> (append_tscom c1 c2,s,stack) \<Rightarrow>\<^bsup>t \<^esup> (s',stack')" 
  apply (induction c1 c2 arbitrary: c' s stack t s' stack' rule: append_tscom.induct)
  apply auto 
  by fastforce+

lemma append_complete: "c' \<turnstile> (append_tscom c1 c2,s,stack) \<Rightarrow>\<^bsup>t \<^esup> (s',stack') \<Longrightarrow> c' \<turnstile> (c1;;c2,s,stack) \<Rightarrow>\<^bsup>t \<^esup> (s',stack')" 
  apply (induction c1 c2 arbitrary: c' s stack t s' stack' rule: append_tscom.induct)
  apply auto 
  by fastforce+

corollary append_correct: "c' \<turnstile> (append_tscom c1 c2,s,stack) \<Rightarrow>\<^bsup>t \<^esup> (s',stack') \<equiv> c' \<turnstile> (c1;;c2,s,stack) \<Rightarrow>\<^bsup>t \<^esup> (s',stack')" 
  by (smt (verit) append_complete append_sound)

fun normalize_branching :: "tscom \<Rightarrow> tscom" ("NORM _ ") where 
   "NORM (IF b\<noteq>0 THEN c1 ELSE c2) = (IF b\<noteq>0 THEN NORM c1 ELSE NORM c2)" 
  |"NORM (c1 ;; c2) =  (append_tscom (NORM c1) (NORM c2))" 
  |"NORM c = c" 

declare normalize_branching.elims[elim]

lemma normalize_branching_sound: "c' \<turnstile> (c,s,stack) \<Rightarrow>\<^bsup>t \<^esup> (s',stack') \<Longrightarrow> c' \<turnstile> (NORM c,s,stack) \<Rightarrow>\<^bsup>t \<^esup> (s',stack')" 
  apply (induction c arbitrary: c' s stack t s' stack' rule: normalize_branching.induct)
         apply auto apply fastforce
   apply fastforce
  by (meson append_correct tSeq)

lemma normalize_branching_complete: "c' \<turnstile> (NORM c,s,stack) \<Rightarrow>\<^bsup>t \<^esup> (s',stack') \<Longrightarrow> c' \<turnstile> (c,s,stack) \<Rightarrow>\<^bsup>t \<^esup> (s',stack')" 
  apply (induction c arbitrary: c' s stack t s' stack' rule: normalize_branching.induct)
         apply auto apply fastforce
   apply fastforce 
  by (smt (verit, ccfv_threshold) append_complete tSeq tSeq_tE)

corollary normalize_branching_correct: "c' \<turnstile> (NORM c,s,stack) \<Rightarrow>\<^bsup>t\<^esup> (s',stack') \<equiv> c' \<turnstile> (c,s,stack) \<Rightarrow>\<^bsup>t\<^esup> (s',stack')" 
  by (smt (verit, ccfv_SIG) normalize_branching_complete normalize_branching_sound)

abbreviation "merge_branch \<equiv> (IF ''b''\<noteq>0 THEN (''r'' ::= A (N 0)) ELSE (''r'' ::= A (N 1))) ;; (IF ''b''\<noteq>0 THEN (''r'' ::= A (N 0)) ELSE (''r'' ::= A (N 1))) ;;  (''r'' ::= A (N 2))"

value "normalize_branching merge_branch"

fun branches :: "tscom \<Rightarrow> bool" where
"branches (c\<^sub>1;;c\<^sub>2) = (branches c\<^sub>1 \<or> branches c\<^sub>2)" |
"branches (IF b\<noteq>0 THEN c\<^sub>1 ELSE c\<^sub>2) = True" |
"branches c = False" 

fun normalized :: "tscom \<Rightarrow> bool"("\<turnstile>\<^bsub>NORM\<^esub> _ ") where
"\<turnstile>\<^bsub>NORM\<^esub> (c\<^sub>1;;c\<^sub>2) = (\<not>branches c\<^sub>1 \<and> \<turnstile>\<^bsub>NORM\<^esub> c\<^sub>2)" |
"\<turnstile>\<^bsub>NORM\<^esub> (IF b\<noteq>0 THEN c\<^sub>1 ELSE c\<^sub>2) = (\<turnstile>\<^bsub>NORM\<^esub> c\<^sub>1 \<and> \<turnstile>\<^bsub>NORM\<^esub> c\<^sub>2)" |
"\<turnstile>\<^bsub>NORM\<^esub> c = True" 

lemma normalized_append: "\<turnstile>\<^bsub>NORM\<^esub> c\<^sub>1 \<Longrightarrow> \<turnstile>\<^bsub>NORM\<^esub> c\<^sub>2 \<Longrightarrow> \<turnstile>\<^bsub>NORM\<^esub> (append_tscom c\<^sub>1 c\<^sub>2 )"
  by (induction c\<^sub>1 c\<^sub>2 rule: append_tscom.induct) auto

lemma normalized_branching: "\<turnstile>\<^bsub>NORM\<^esub> (NORM c)"
  by (induction c rule: normalize_branching.induct) (auto simp add: normalized_append)

lemma branches_equiv: "c \<equiv>\<^sub>\<turnstile>\<^sub>i c' \<Longrightarrow> (branches #\<lbrakk>c\<rbrakk>\<inverse> \<longleftrightarrow> branches #\<lbrakk>c\<rbrakk>\<inverse>)" 
  by (induction c c' rule: sem_equiv.induct) auto

lemma normalized_equiv: "c \<equiv>\<^sub>\<turnstile>\<^sub>i c' \<Longrightarrow> (\<turnstile>\<^bsub>NORM\<^esub> #\<lbrakk>c\<rbrakk>\<inverse> \<longleftrightarrow> \<turnstile>\<^bsub>NORM\<^esub> #\<lbrakk>c\<rbrakk>\<inverse>)" 
  by (induction c c' rule: sem_equiv.induct) (auto simp add: branches_equiv)

end