section \<open>Determining stack manipulation with semantics\<close>

subsection \<open>Was a variable pushed?\<close>

inductive
  pushed :: "vname \<Rightarrow> tscom \<Rightarrow> (tscom \<times> state \<times> fstack) \<Rightarrow> bool" (" _ PUSH _ \<turnstile> _" 55)
  where
pushedSeq1: "v PUSH c \<turnstile> (c1,s1,stack1) \<Longrightarrow> v PUSH c \<turnstile> (c1;;c2,s1,stack1)" |
pushedSeq2: "\<lbrakk>v PUSH c \<turnstile> (c2,s2,stack2) ; c \<turnstile>(c1,s1,stack1) \<Rightarrow>\<^bsup>t \<^esup> (s2,stack2)\<rbrakk> \<Longrightarrow>  v PUSH c \<turnstile> (c1;;c2,s1,stack1)" |
pushedIfTrue: "\<lbrakk> s b \<noteq> 0 ; v PUSH c \<turnstile> (c1,s,stack) \<rbrakk> \<Longrightarrow> v PUSH c \<turnstile> (IF b \<noteq>0 THEN c1 ELSE c2,s,stack)" |
pushedIfFalse: "\<lbrakk> s b = 0 ; v PUSH c \<turnstile> (c2,s,stack) \<rbrakk> \<Longrightarrow> v PUSH c \<turnstile> (IF b \<noteq>0 THEN c1 ELSE c2,s,stack)" |
pushedTail: "v PUSH c \<turnstile> (c,s,stack) \<Longrightarrow> v PUSH c \<turnstile> (tsTAIL,s,stack)"|
pushedPush: "v = x \<Longrightarrow> v PUSH c \<turnstile> (PUSH x,s,stack)"

code_pred pushed .

declare pushed.intros[intro]

lemmas pushed_induct = pushed.induct[split_format(complete)]

inductive_cases pushedSkip_tE[elim!]: "y PUSH c \<turnstile> (tsSKIP,s,stack)"
inductive_cases pushedAssign_tE[elim!]: "y PUSH c \<turnstile> (x ::= a,s,stack)"
inductive_cases pushedSeq_tE[elim!]: "y PUSH c \<turnstile> (c1;;c2,s1,stack) "
inductive_cases pushedIf_tE[elim!]: "y PUSH c \<turnstile> (IF b \<noteq>0 THEN c1 ELSE c2,s,stack)"
inductive_cases pushedCall_tE[elim!]: "y PUSH c \<turnstile> (CALL C RETURN v,s,stack)"
inductive_cases pushedTail_tE[elim]: "y PUSH c \<turnstile> (tsTAIL,s,stack)"
inductive_cases pushedPush_tE[elim!]: "y PUSH c \<turnstile> (PUSH x,s,stack)"
inductive_cases pushedPop_tE[elim!]: "y PUSH c \<turnstile> (POP x,s,stack)"

lemma no_push_stack_length: "c' \<turnstile>(c,s,stack) \<Rightarrow>\<^bsup>t \<^esup> (s',stack') \<Longrightarrow> \<not> v PUSH c' \<turnstile> (c,s,stack) \<Longrightarrow> length(stack v) \<ge> length(stack' v)"
  by (induction c' c s stack t s' stack' rule: tsbig_step_t_induct) fastforce+

lemma push_many_set: "v \<in> set (vs) \<equiv> v PUSH c \<turnstile> (PUSHMANY vs,s,stack)"
  by (induction vs arbitrary: stack s rule: push_many.induct) auto

lemma no_pushed_many: "v \<notin> set (vs) \<equiv> \<not> (v PUSH c \<turnstile> (PUSHMANY vs,s,stack))"
  using push_many_set by auto

lemma push_push_many: "x PUSH c' \<turnstile> (PUSHMANY (x#xs),s,stack)" by auto

subsection \<open>Was a list of variables pushed?\<close>

inductive pushed_many :: "vname list \<Rightarrow> tscom \<Rightarrow> (tscom \<times> state \<times> fstack) \<Rightarrow> bool" (" _ PUSHMANY _ \<turnstile> _" 55) where
 empty: "[] PUSHMANY c' \<turnstile> (c,s,stack)" |
 step: "x PUSH c' \<turnstile> (c,s,stack) \<Longrightarrow> xs PUSHMANY c' \<turnstile> (c,s,stack) \<Longrightarrow> (x#xs) PUSHMANY c' \<turnstile> (c,s,stack)"

declare pushed_many.intros[intro]

lemmas pushed_many_induct = pushed_many.induct[split_format(complete)]

lemma pushed_many_set: "xs PUSHMANY c' \<turnstile> (c,s,stack) \<Longrightarrow> \<forall>x \<in> set xs. (x PUSH c' \<turnstile> (c,s,stack))"
  by (induction xs c' c s stack rule: pushed_many_induct) auto

lemma set_pushed_many: "\<forall>x \<in> set xs. (x PUSH c' \<turnstile> (c,s,stack)) \<Longrightarrow> xs PUSHMANY c' \<turnstile> (c,s,stack)"
  by (induction xs arbitrary: c' c s stack) auto

corollary pushed_many_set': "xs PUSHMANY c' \<turnstile> (c,s,stack) \<longleftrightarrow> (\<forall>x \<in> set xs. (x PUSH c' \<turnstile> (c,s,stack)))"
  by (smt (verit, del_insts) pushed_many_set set_pushed_many)

lemma pushed_push_many: "xs PUSHMANY c' \<turnstile> (PUSHMANY xs,s,stack)"
  using set_pushed_many push_many_set by auto

text \<open>Was a variable popped?\<close>

inductive
  popped :: "vname \<Rightarrow> tscom \<Rightarrow> (tscom \<times> state \<times> fstack) \<Rightarrow> bool" (" _ POP _ \<turnstile> _" 55)
  where
poppedSeq1: "v POP c \<turnstile> (c1,s1,stack1) \<Longrightarrow> v POP c \<turnstile> (c1;;c2,s1,stack1)" |
poppedSeq2: "\<lbrakk>v POP c \<turnstile> (c2,s2,stack2) ; c \<turnstile>(c1,s1,stack1) \<Rightarrow>\<^bsup>t \<^esup> (s2,stack2)\<rbrakk> \<Longrightarrow>  v POP c \<turnstile> (c1;;c2,s1,stack1)" |
poppedIfTrue: "\<lbrakk> s b \<noteq> 0 ; v POP c \<turnstile> (c1,s,stack) \<rbrakk> \<Longrightarrow> v POP c \<turnstile> (IF b \<noteq>0 THEN c1 ELSE c2,s,stack)" |
poppedIfFalse: "\<lbrakk> s b = 0 ; v POP c \<turnstile> (c2,s,stack) \<rbrakk> \<Longrightarrow> v POP c \<turnstile> (IF b \<noteq>0 THEN c1 ELSE c2,s,stack)" |
poppedTail: "v POP c \<turnstile> (c,s,stack) \<Longrightarrow> v POP c \<turnstile> (tsTAIL,s,stack)"|
poppedPop: "\<lbrakk> v = x ; stack v = Cons va vx \<rbrakk>  \<Longrightarrow> v POP c \<turnstile> (POP x,s,stack)"

code_pred popped .

declare popped.intros[intro]

lemmas popped_induct = popped.induct[split_format(complete)]

inductive_cases poppedSkip_tE[elim!]: "y POP c \<turnstile> (tsSKIP,s,stack)"
inductive_cases poppedAssign_tE[elim!]: "y POP c \<turnstile> (x ::= a,s,stack)"
inductive_cases poppedSeq_tE[elim!]: "y POP c \<turnstile> (c1;;c2,s1,stack) "
inductive_cases poppedIf_tE[elim!]: "y POP c \<turnstile> (IF b \<noteq>0 THEN c1 ELSE c2,s,stack)"
inductive_cases poppedCall_tE[elim!]: "y POP c \<turnstile> (CALL C RETURN v,s,stack)"
inductive_cases poppedTail_tE[elim]: "y POP c \<turnstile> (tsTAIL,s,stack)"
inductive_cases poppedPush_tE[elim!]: "y POP c \<turnstile> (PUSH x,s,stack)"
inductive_cases poppedPop_tE[elim!]: "y POP c \<turnstile> (POP x,s,stack)"

lemma no_pop_stack_length: "c' \<turnstile>(c,s,stack) \<Rightarrow>\<^bsup>t \<^esup> (s',stack') \<Longrightarrow> \<not> v POP c' \<turnstile> (c,s,stack) \<Longrightarrow> length (stack v) \<le> length(stack' v)"
  by (induction c' c s stack t s' stack' rule: tsbig_step_t_induct) fastforce+

lemma many_popped1: "v POP c \<turnstile> (POP x, s, stack) \<Longrightarrow> v POP c \<turnstile> (POPMANY x#vs,s,stack)" 
  by auto

lemma many_popped1': "stack v = Cons va vx \<Longrightarrow> v POP c \<turnstile> (POPMANY v#vs,s,stack)" 
  by auto

lemma pop_many_set: "v POP c \<turnstile> (popmany,s,stack) \<Longrightarrow> popmany = POPMANY vs \<Longrightarrow> v \<in> set (vs)"
  by (induction vs arbitrary: popmany stack s rule: pop_many.induct) auto

lemma set_pop_many: 
  assumes "\<forall> v \<in> set (vs) . count_list vs v \<le> length (stack v)"
  shows "v \<in> set (vs) \<Longrightarrow> v POP c \<turnstile> (POPMANY vs,s,stack)"
using assms proof (induction vs arbitrary: stack s rule: pop_many.induct)
  case 1
  then show ?case by auto
next
  case (2 va vs)
  then show ?case proof (cases "v = va")
    case True
    then show ?thesis apply auto 
      by (metis "2.prems"(1,2) Suc_le_length_iff bot_nat_0.extremum_uniqueI count_list_0_iff not_less_eq_eq poppedPop poppedSeq1)
  next
    case False
    have \<open>v \<in> set vs\<close> 
      using "2.prems"(1) False by auto
    obtain hva tlva where \<open>stack va = hva#tlva\<close>
      by (metis "2.prems"(2) bot_nat_0.extremum_uniqueI count_list_0_iff length_0_conv list.exhaust
          list.set_intros(1))
    hence \<open>c \<turnstile>(POP va,s,stack) \<Rightarrow>\<^bsup>Suc 0 \<^esup> (s(va := hva), stack(va := tlva))\<close> by blast
    hence \<open>\<forall>v\<in>set vs. count_list vs v \<le> length ((stack(va := tlva)) v)\<close>
      by (metis "2.prems"(2) Suc_eq_plus1 Suc_le_mono \<open>stack va = hva # tlva\<close> count_list.simps(2) count_list_0_iff
          fun_upd_apply length_Cons list.set_intros(1))
    hence \<open>v POP c \<turnstile> (POPMANY vs , s(va := hva), stack(va := tlva))\<close> 
      using "2.IH" \<open>v \<in> set vs\<close> by blast
    then show ?thesis
      using \<open>c \<turnstile> (POP va, s, stack) \<Rightarrow>\<^bsup>Suc 0\<^esup> (s(va := hva), stack(va := tlva))\<close> by auto
  qed 
qed 

lemma pop_many_set': \<open>\<forall> v \<in> set (vs) . count_list vs v \<le> length (stack v) \<Longrightarrow> (v \<in> set (vs) \<equiv> v POP c \<turnstile> (POPMANY vs,s,stack))\<close>
  by (smt (verit, ccfv_SIG) pop_many_set set_pop_many)

