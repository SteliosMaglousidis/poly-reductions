instantiation rcom_tagged :: vars
begin

fun vars_rcom_tagged :: "rcom_tagged \<Rightarrow> vname list" where
"vars_rcom_tagged (#n\<rightharpoonup> x ::= a)  = x # vars a" |
"vars_rcom_tagged (c\<^sub>1#;;c\<^sub>2) = vars_rcom_tagged c\<^sub>1 @ vars_rcom_tagged c\<^sub>2" |
"vars_rcom_tagged (#IF b\<noteq>0 THEN c1 ELSE c2) = b # vars_rcom_tagged c1 @ vars_rcom_tagged c2" |
"vars_rcom_tagged (#n\<rightharpoonup> CALL c RETURN r) = r#vars c" |
"vars_rcom_tagged _ = []"

instance ..

end

lemma tagged_rcom_vars: "vars c = vars #\<^sub>r\<lbrakk> c \<rbrakk>"
  by (induction c) auto

lemma rcom_tagged_vars: "vars c = vars #\<^sub>r\<lbrakk> c \<rbrakk>\<inverse>"
  by (induction c) auto

lemma rcom_tag_correct : "#\<^sub>r\<lbrakk> #\<^sub>r\<lbrakk> c \<rbrakk>  \<rbrakk>\<inverse> = c"
  by (induction c rule: tag_rcom.induct) fastforce+

(* Syntactically has a recursive call *)
fun has_rec_tagged :: "rcom_tagged \<Rightarrow> bool" where
  "has_rec_tagged #n\<rightharpoonup> RECURSE \<longleftrightarrow> True" |
  "has_rec_tagged (c1#;;c2) \<longleftrightarrow> has_rec_tagged c1 \<or> has_rec_tagged c2" |
  "has_rec_tagged (#IF b\<noteq>0 THEN c1 ELSE c2) \<longleftrightarrow> has_rec_tagged c1 \<or> has_rec_tagged c2" |
  "has_rec_tagged _ \<longleftrightarrow> False"

fun tagged_invar :: "rcom_tagged \<Rightarrow> bool" where
  "tagged_invar (c\<^sub>1#;;c\<^sub>2) \<longleftrightarrow> \<not>has_rec_tagged c\<^sub>1 \<and> tagged_invar c\<^sub>2" |
  "tagged_invar (#IF b\<noteq>0 THEN c\<^sub>1 ELSE c\<^sub>2) \<longleftrightarrow> tagged_invar c\<^sub>1 \<and> tagged_invar c\<^sub>2" |
  "tagged_invar _ \<longleftrightarrow> True"


datatype
  tscom_tagged = tsSKIPTagged "nat option"
      | tsAssignTagged "nat option" vname aexp
      | tsSeqTagged tscom_tagged tscom_tagged
      | tsIfTagged vname tscom_tagged tscom_tagged
      | tsCallTagged "nat option" com vname
      | tsTailTagged "nat option"
      | tsPushTagged "nat option" vname
      | tsPopTagged "nat option" vname

open_bundle tscom_tagged_syntax begin
notation tsSKIPTagged ("#_\<rightharpoonup> SKIP") and
         tsAssignTagged ("#_\<rightharpoonup> _ ::= _" [1000, 61] 61) and
         tsSeqTagged ("_ #;; _" [60, 61] 60) and
         tsIfTagged ("(#IF _/\<noteq>0 THEN _ ELSE _)" [0, 0, 61] 61) and
         tsCallTagged ("#_\<rightharpoonup> CALL _ RETURN _") and
         tsTailTagged ("#_\<rightharpoonup> TAIL") and
         tsPushTagged ("#_\<rightharpoonup> PUSH _") and
         tsPopTagged ("#_\<rightharpoonup> POP _")
end

unbundle tscom_syntax and no com'_syntax and no rcom_syntax

instantiation tscom_tagged :: vars
begin

fun vars_tscom_tagged :: "tscom_tagged \<Rightarrow> vname list" where
"vars_tscom_tagged (#n\<rightharpoonup> x ::= a)  = x # vars a" |
"vars_tscom_tagged (c\<^sub>1#;;c\<^sub>2) = vars_tscom_tagged c\<^sub>1 @ vars_tscom_tagged c\<^sub>2" |
"vars_tscom_tagged (#IF b\<noteq>0 THEN c1 ELSE c2) = b # vars_tscom_tagged c1 @ vars_tscom_tagged c2" |
"vars_tscom_tagged (#n\<rightharpoonup> CALL c RETURN r) = r#vars c" |
"vars_tscom_tagged (#n\<rightharpoonup>PUSH x)  = [x]" |
"vars_tscom_tagged (#n\<rightharpoonup>POP x)  = [x]" |
"vars_tscom_tagged _ = []"

instance ..

end


fun tag_tscom :: "tscom \<Rightarrow> tscom_tagged" ("#\<lbrakk> _ \<rbrakk>") where
  "tag_tscom (ct1 ;; ct2) = tag_tscom ct1 #;; tag_tscom ct2" |
  "tag_tscom (IF b\<noteq>0 THEN ct1 ELSE ct2) = (#IF b\<noteq>0 THEN tag_tscom ct1 ELSE tag_tscom ct2)" |
  "tag_tscom tsTAIL = (#None\<rightharpoonup> TAIL)" |
  "tag_tscom (tsSKIP) = (#None\<rightharpoonup> SKIP)" |
  "tag_tscom (x ::= a) = (#None\<rightharpoonup>x ::= a)" |
  "tag_tscom (CALL v RETURN r) = (#None\<rightharpoonup>CALL v RETURN r)" |
  "tag_tscom (PUSH v) = (#None\<rightharpoonup>PUSH v)" |
  "tag_tscom (POP v) = (#None\<rightharpoonup>POP v)" 

fun untag_tscom :: "tscom_tagged \<Rightarrow> tscom" ("#\<lbrakk> _ \<rbrakk>\<inverse>")where
  "untag_tscom (ct1 #;; ct2) = untag_tscom ct1 ;; untag_tscom ct2" |
  "untag_tscom (#IF b\<noteq>0 THEN ct1 ELSE ct2) = (IF b\<noteq>0 THEN untag_tscom ct1 ELSE untag_tscom ct2)" |
  "untag_tscom (#i\<rightharpoonup> TAIL) = tsTAIL" |
  "untag_tscom (#i\<rightharpoonup> SKIP) = tsSKIP" |
  "untag_tscom (#i\<rightharpoonup> x ::= a) = (x ::= a)" |
  "untag_tscom (#i\<rightharpoonup>CALL v RETURN r) = (CALL v RETURN r)"|
  "untag_tscom (#i\<rightharpoonup>PUSH v) = (PUSH v)" |
  "untag_tscom (#i\<rightharpoonup>POP v) = (POP v)" 

lemma tscom_tag_correct : "untag_tscom (tag_tscom c) = c"
  by (induction c rule: tag_tscom.induct) fastforce+

fun stails_tagged :: "tscom_tagged \<Rightarrow> bool" where
  "stails_tagged #n\<rightharpoonup> TAIL \<longleftrightarrow> True" |
  "stails_tagged (c1#;;c2) \<longleftrightarrow> stails_tagged c1 \<or> stails_tagged c2" |
  "stails_tagged (#IF b\<noteq>0 THEN c1 ELSE c2) \<longleftrightarrow> stails_tagged c1 \<or> stails_tagged c2" |
  "stails_tagged _ \<longleftrightarrow> False"

fun sinvar_tagged :: "tscom_tagged \<Rightarrow> bool" where
  "sinvar_tagged (c\<^sub>1#;;c\<^sub>2) \<longleftrightarrow> \<not>sinvar_tagged c\<^sub>1 \<and> sinvar_tagged c\<^sub>2" |
  "sinvar_tagged (#IF b\<noteq>0 THEN c\<^sub>1 ELSE c\<^sub>2) \<longleftrightarrow> sinvar_tagged c\<^sub>1 \<and> sinvar_tagged c\<^sub>2" |
  "sinvar_tagged _ \<longleftrightarrow> True"

fun push_many_tagged :: "vname list \<Rightarrow> tscom_tagged" ("(#PUSH# _ )"  [61] 61) where
"push_many_tagged [] = #None\<rightharpoonup> SKIP" |
"push_many_tagged (v#vs) = (#None\<rightharpoonup>PUSH v) #;; push_many_tagged vs" 

fun pop_many_tagged :: "vname list \<Rightarrow> tscom_tagged" ("(#POP# _ )"  [61] 61) where
"pop_many_tagged [] = #None\<rightharpoonup> SKIP" |
"pop_many_tagged (v#vs) = (#None\<rightharpoonup>POP v)  #;; pop_many_tagged vs" 


