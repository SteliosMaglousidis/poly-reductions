theory Com_Tagged
  imports "General_Recursive_IMP/IMP_GRec" 
          "Tail_Recursive_IMP_Stack/IMP_Tailcall_Stacked"
          "Tail_Recursive_IMP_Stack/TsComsExtended"
begin

(* Do it in two datatypes *)

datatype
  rcom_tagged = rSKIPTagged "nat option"
      | rAssignTagged "nat option" vname aexp
      | rSeqTagged rcom_tagged rcom_tagged
      | rIfTagged vname rcom_tagged rcom_tagged
      | rCallTagged "nat option" com vname 
      | rRecTagged "nat option" 

open_bundle rcom_tagged_syntax begin
notation rSKIPTagged ("#_\<rightharpoonup> SKIP") and
         rAssignTagged ("#_\<rightharpoonup> _ ::= _" [1000, 61] 61) and
         rSeqTagged ("_ #;; _" [60, 61] 60) and
         rIfTagged ("(#IF _/\<noteq>0 THEN _ ELSE _)" [0, 0, 61] 61) and
         rCallTagged ("#_\<rightharpoonup> CALL _ RETURN _") and
         rRecTagged ("#_\<rightharpoonup> RECURSE ")
end

unbundle rcom_syntax and no com'_syntax and no tscom_syntax

fun tag_rcom :: "rcom \<Rightarrow> rcom_tagged" ("#\<^sub>r\<lbrakk> _ \<rbrakk>")where
  "tag_rcom (ct1 ;; ct2) = tag_rcom ct1 #;; tag_rcom ct2" |
  "tag_rcom (IF b\<noteq>0 THEN ct1 ELSE ct2) = (#IF b\<noteq>0 THEN tag_rcom ct1 ELSE tag_rcom ct2)" |
  "tag_rcom RECURSE = #None\<rightharpoonup>RECURSE " |
  "tag_rcom (rSKIP) = (#None\<rightharpoonup>SKIP)" |
  "tag_rcom (x ::= a) = (#None \<rightharpoonup> x ::= a)" |
  "tag_rcom (CALL c RETURN r) = (#None \<rightharpoonup>CALL c RETURN r)" 

fun untag_rcom :: "rcom_tagged \<Rightarrow> rcom" ("#\<^sub>r\<lbrakk> _ \<rbrakk>\<inverse>")where
  "untag_rcom (ct1 #;; ct2) = untag_rcom ct1 ;; untag_rcom ct2" |
  "untag_rcom (#IF b\<noteq>0 THEN ct1 ELSE ct2) = (IF b\<noteq>0 THEN untag_rcom ct1 ELSE untag_rcom ct2)" |
  "untag_rcom #n\<rightharpoonup> RECURSE = RECURSE" |
  "untag_rcom #n\<rightharpoonup> SKIP = rSKIP" |
  "untag_rcom (#n\<rightharpoonup> x ::= a) = (x ::= a)" |
  "untag_rcom (#n\<rightharpoonup> CALL c RETURN r) = (CALL c RETURN r)" 

