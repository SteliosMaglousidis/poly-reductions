theory GRecToTRec
  imports General_Recursive_IMP.IMP_GRec Tail_Recursive_IMP_Stack.IMP_Tailcall_Stacked Tail_Recursive_IMP_Stack.TsComsExtended
begin


datatype
  (* Skip 0 is normal skip, 
     Skip 1 signifies descending the recursion tree,
     Skip 2 signifies ascending the recursion tree. *)

  rcom_tagged = rSKIPTagged nat
      | rAssignTagged vname aexp
      | rSeqTagged rcom_tagged rcom_tagged
      | rIfTagged vname rcom_tagged rcom_tagged
      | rCallTagged com vname
      | rRecTagged nat 

notation rAssignTagged ("_ #::= _" [1000, 61] 61) and
         rSeqTagged ("_ #;; _" [60, 61] 60) and
         rIfTagged ("(#IF _/\<noteq>0 THEN _ ELSE _)" [0] 61) and
         rCallTagged ("#CALL _ RETURN _") and
         rRecTagged ("#RECURSE _")

unbundle rcom_syntax and no com'_syntax and no tscom_syntax


(* Ident Recursive Calls *)

fun id_rec_calls_n :: "rcom \<Rightarrow> nat \<Rightarrow> rcom_tagged" where
  "id_rec_calls_n (ct1 ;; ct2) n = (id_rec_calls_n ct1 n) #;; (id_rec_calls_n ct2 (n + rec_call_count ct1))" |
  "id_rec_calls_n (IF b\<noteq>0 THEN ct1 ELSE ct2) n = (#IF b\<noteq>0 THEN (id_rec_calls_n ct1 n) ELSE id_rec_calls_n ct2 (n + rec_call_count ct1))" |
  "id_rec_calls_n RECURSE n = #RECURSE n" |
  "id_rec_calls_n (rSKIP) n = (rSKIPTagged 0)" |
  "id_rec_calls_n (x ::= a) n = (x #::= a)" |
  "id_rec_calls_n (CALL v RETURN r) n = (#CALL v RETURN r)" 

abbreviation "id_rec_calls c \<equiv> id_rec_calls_n c 0"


value "id_rec_calls (IF n=0 ON b THEN (ret ::= A (N 0)) ELSE 
                     (IF n=1 ON b THEN (ret ::= A (N 1)) ELSE 
                          (n ::= Sub (V n) (N 1)) ;;
                            RECURSE ;;
                            (r1 ::= A (V ret)) ;;
                            (n ::= Sub (V n) (N 1)) ;;
                            RECURSE ;;
                            (r2 ::= A (V ret)) ;;
                            (ret ::= Plus (V r1) (V r2))
                            ))"

fun normalize_left :: "rcom_tagged \<Rightarrow> rcom_tagged" where
 "normalize_left ((ct1 #;; ct2) #;; ct3) = (normalize_left ct1 #;; (normalize_left ct2 #;; normalize_left ct3))" |
 "normalize_left (ct1 #;; ct2) = (normalize_left ct1 #;; normalize_left ct2)" |
 "normalize_left (#IF b\<noteq>0 THEN ct1 ELSE ct2) = (#IF b\<noteq>0 THEN normalize_left ct1 ELSE normalize_left ct2)" |
 "normalize_left c = c"

fun switch_branch :: "rcom_tagged \<Rightarrow> rcom_tagged" where
 "switch_branch (#RECURSE n) = (#RECURSE n)" |
 "switch_branch (ct1 #;; #RECURSE n) = (switch_branch ct1) #;; (#RECURSE n)" |
 "switch_branch (#IF b\<noteq>0 THEN ct1 ELSE ct2) = (#IF b\<noteq>0 THEN (switch_branch ct1) ELSE (switch_branch ct2))"|
 "switch_branch (ct1 #;; ct2) = ((switch_branch ct1) #;; (switch_branch ct2))" |
 "switch_branch c = c"

fun has_rec_call :: "rcom_tagged \<Rightarrow> bool" where
 "has_rec_call (#IF b\<noteq>0 THEN ct1 ELSE ct2) = ((has_rec_call ct1) \<or> (has_rec_call ct2))"
|"has_rec_call (ct1 #;; ct2) = ((has_rec_call ct1) \<or> (has_rec_call ct2))"
|"has_rec_call (#RECURSE n) = True"
|"has_rec_call c = False"

fun the_next :: "rcom_tagged \<Rightarrow> rcom_tagged list" where
 "the_next (#RECURSE n) = []" |
 "the_next ((#RECURSE n) #;; ct2) = [ct2]" |
 "the_next (#IF b\<noteq>0 THEN ct1 ELSE ct2) = (the_next ct1) @ (the_next ct2)"|
 "the_next (ct1 #;; ct2) = the_next ct2" |
 "the_next c = []"

lemma next_size: "nc \<in> set (the_next c) \<Longrightarrow> size nc \<le> size c"
  by (induction c rule: the_next.induct) auto

function switch_branches :: "rcom_tagged \<Rightarrow> rcom_tagged list \<Rightarrow> rcom_tagged list" where
 "switch_branches c sbs = 
    (if the_next c = [] then (switch_branch c)#sbs 
      else concat (map (\<lambda> x. switch_branches x ((switch_branch c)#sbs)) (the_next c)))"
  by auto

fun add_pop_skips :: "rcom_tagged \<Rightarrow> rcom_tagged" where
 "add_pop_skips (#IF b\<noteq>0 THEN ct1 ELSE ct2) = (#IF b\<noteq>0 THEN (add_pop_skips ct1) ELSE (add_pop_skips ct2)) "
|"add_pop_skips (ct1 #;; ct2) = ((add_pop_skips ct1) #;; (add_pop_skips ct2))"
|"add_pop_skips (#RECURSE n) = (#RECURSE n)"
|"add_pop_skips c = c #;; rSKIPTagged 1"

unbundle tscom_syntax and no com'_syntax and no rcom_syntax

fun branch_to_tail_stack :: "rcom_tagged \<Rightarrow> vname list \<Rightarrow> tscom" where
 "branch_to_tail_stack (#IF b\<noteq>0 THEN ct1 ELSE ct2) pvars = (IF b\<noteq>0 THEN (branch_to_tail_stack ct1 pvars) ELSE (branch_to_tail_stack ct2 pvars))"
|"branch_to_tail_stack (ct1 #;; ct2) pvars = ((branch_to_tail_stack ct1 pvars) ;; (branch_to_tail_stack ct2 pvars))"
|"branch_to_tail_stack (#RECURSE n) pvars = 
                           (push_many pvars ;;
                            (''pc'' ::= A (N n)) ;;
                            PUSH ''pc'' ;;
                            (''pc'' ::= A (N 1)) ;;
                            tsTAIL) "
|"branch_to_tail_stack (rSKIPTagged (Suc 0)) pvars = 
                           (pop_many pvars ;;
                            POP ''pc'')"
|"branch_to_tail_stack (rSKIPTagged n) pvars = tsSKIP"
|"branch_to_tail_stack (v #::= a) pvars = (v ::= a)"
|"branch_to_tail_stack (#CALL v RETURN r) pvars = (CALL v RETURN r)"




end